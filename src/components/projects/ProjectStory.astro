---
import type { Project } from '@/data/projects';
import type { Story } from '@/data/stories';
import StoryMedia from './StoryMedia.astro';
import NextProjectLink from './NextProjectLink';
import RevealOnScroll from '@/components/RevealOnScroll.astro';
import { DEFAULT_LOCALE, localePath, type Locale } from '@/lib/i18n';

/*
 * The story under a project's title screen: a line of context with the role, stack and site beside it, a lead clip
 * or picture, why each piece of the stack was chosen, more pictures, a few curiosities, and the way on to the next
 * project, bottom right. Blocks rise in as they
 * scroll into view (RevealOnScroll); the script below plays clips only while they are on screen.
 */

const { project, story, next, locale = DEFAULT_LOCALE } = Astro.props as { project: Project; story: Story; next: Project; locale?: Locale };
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<section
	data-project-story
	aria-labelledby="story-title"
	class="flex flex-col gap-[clamp(4rem,12vh,9rem)] px-[clamp(1.5rem,7vw,10rem)] pt-[clamp(4rem,12vh,8rem)] pb-[clamp(5rem,16vh,11rem)]"
>
	<h2 id="story-title" class="sr-only">About {project.name}</h2>

	<div data-reveal class="grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] md:gap-20">
		<p class="text-[clamp(1.5rem,2.6vw,2.5rem)] leading-[1.2] font-medium tracking-[-0.015em] text-pretty">{story.intro}</p>
		<dl class="grid content-start gap-6 text-base">
			<div class="flex flex-col gap-1.5">
				<dt class="legend text-ink/50">Role</dt>
				<dd>{story.role}</dd>
			</div>
			<div class="flex flex-col gap-1.5">
				<dt class="legend text-ink/50">Stack</dt>
				<dd>{story.stack.map((choice) => choice.name).join(' · ')}</dd>
			</div>
			<div class="flex flex-col gap-1.5">
				<dt class="legend text-ink/50">Site</dt>
				<dd>
					{
						project.url ? (
							<a href={project.url} target="_blank" rel="noopener noreferrer" class="underline decoration-ink/30 underline-offset-4 transition-colors hover:decoration-ink">
								{project.domain} ↗<span class="sr-only"> (opens in a new tab)</span>
							</a>
						) : (
							'Private tool'
						)
					}
				</dd>
			</div>
		</dl>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
		<StoryMedia item={story.lead} />
	</div>

	<div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-20">
		<h2 data-reveal class="font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-none font-semibold tracking-[-0.03em]">Why this stack</h2>
		<ul class="border-t border-ink/15">
			{
				story.stack.map((choice) => (
					<li data-reveal class="grid gap-2 border-b border-ink/15 py-6 sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] sm:gap-10">
						<h3 class="font-display text-lg font-semibold tracking-[-0.01em]">{choice.name}</h3>
						<p class="leading-relaxed text-pretty text-ink/75">{choice.why}</p>
					</li>
				))
			}
		</ul>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
		{story.gallery.map((item) => <StoryMedia item={item} />)}
	</div>

	<div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-20">
		<h2 data-reveal class="font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-none font-semibold tracking-[-0.03em]">Curiosities</h2>
		<ol class="border-t border-ink/15">
			{
				story.curiosities.map((note, i) => (
					<li data-reveal class="grid grid-cols-[3rem_minmax(0,1fr)] gap-4 border-b border-ink/15 py-6 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-10">
						<span class="legend pt-1.5 text-ink/50" aria-hidden="true">{number(i)}</span>
						<p class="text-lg leading-snug text-pretty">{note}</p>
					</li>
				))
			}
		</ol>
	</div>

	<div data-reveal class="flex justify-end">
		<NextProjectLink client:visible name={next.name} href={localePath(locale, `/projects/${next.slug}`)} />
	</div>
</section>

<RevealOnScroll />

<script>
	// Clips play only while on screen; under reduced motion they never start on their own and get controls instead.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const videos = document.querySelectorAll<HTMLVideoElement>('[data-story-video]');
	// Clips loop by hand, back to where their content starts rather than to the blank first frame of the recording.
	videos.forEach((video) => {
		const start = Number(video.dataset.start) || 0;
		video.addEventListener('ended', () => {
			video.currentTime = start;
			if (!reduce) video.play().catch(() => {});
		});
	});
	if (reduce) {
		videos.forEach((video) => (video.controls = true));
	} else {
		const playing = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) video.play().catch(() => (video.controls = true));
					else video.pause();
				}
			},
			{ threshold: 0.35 }
		);
		videos.forEach((video) => playing.observe(video));
	}
</script>

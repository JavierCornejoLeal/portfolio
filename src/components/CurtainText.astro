---
/**
 * Splits text into glyphs that rise from behind a clip edge one after another.
 * Screen readers get the plain text; the animated glyphs are hidden from them.
 */
interface Props {
	text: string;
	/** Seconds before the first glyph starts. */
	delay?: number;
	/** Seconds between consecutive glyphs. */
	step?: number;
}

const { text, delay = 0, step = 0.02 } = Astro.props;

let index = 0;
const words = text.split(' ').map(word =>
	[...word].map(glyph => ({ glyph, start: (delay + index++ * step).toFixed(3) }))
);
---

<span class="sr-only">{text}</span><span aria-hidden="true"
	>{
		words.map((glyphs, w) => (
			<>
				<span class="whitespace-nowrap">
					{glyphs.map(({ glyph, start }) => (
						<span class="curtain-letter" style={`--start: ${start}s`}>
							{glyph}
						</span>
					))}
				</span>
				{w < words.length - 1 && ' '}
			</>
		))
	}</span
>

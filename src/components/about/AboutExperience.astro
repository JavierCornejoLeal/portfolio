---
import AboutSection from './AboutSection.astro';
import { education, experience } from '@/data/portfolio';
---

<AboutSection id="experience" title="Experience">
	<div class="flex flex-col gap-16">
		<!-- A ledger: when, where, what. -->
		<ol>
			{
				experience.map((role) => (
					<li class="grid gap-3 py-8 md:grid-cols-[13rem_minmax(0,1fr)_minmax(0,1.3fr)] md:gap-10">
						<span class="legend pt-2 text-ink/50">{role.period}</span>
						<div class="flex flex-col gap-1">
							<h3 class="font-display text-[clamp(1.5rem,2.4vw,2.25rem)] leading-tight font-semibold tracking-[-0.02em]">{role.company}</h3>
							<p class="text-ink/70">{role.title}</p>
							{role.place && <p class="text-ink/45">{role.place}</p>}
						</div>
						<div class="flex flex-col gap-5 md:pt-2">
							<p class="leading-relaxed text-pretty text-ink/70">{role.detail}</p>
							{role.highlights && (
								<ul class="flex flex-col gap-2.5">
									{role.highlights.map((point) => (
										<li class="relative pl-5 leading-relaxed text-pretty text-ink/70 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-ink/40">
											{point}
										</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))
			}
		</ol>
		<div class="flex flex-col gap-6">
			<span class="legend text-ink/45">Before and alongside</span>
			<ul class="flex flex-col">
				{
					education.map((study) => (
						<li class="grid gap-1 py-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-10">
							<span class="legend pt-1 text-ink/45">{study.period}</span>
							<p>
								{study.title}
								<span class="text-ink/45"> · {study.company}</span>
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</AboutSection>

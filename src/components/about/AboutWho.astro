---
import AboutSection from './AboutSection.astro';
import { aboutFor } from '@/data/about';
import type { Locale } from '@/lib/i18n';
import { uiFor } from '@/data/ui';

const { locale } = Astro.props as { locale: Locale };
const { who } = aboutFor(locale);
// The phrase the opening line turns on: filled with drifting green lines (.canvas-text in global.css).
const { turn } = who;
const [before, after] = who.lead.split(turn);
---

<AboutSection id="who" title={uiFor(locale).about.sections.who}>
	<div class="flex flex-col gap-[clamp(3rem,8vh,5rem)]">
		<p class="text-[clamp(1.75rem,3vw,3rem)] leading-[1.15] font-medium tracking-[-0.02em] text-pretty">
			{before}<span data-canvas-text class="canvas-text">{turn}</span>{after}
		</p>
		<div data-who-text class="flex flex-col gap-6 text-xl leading-relaxed text-ink/75">
			{who.paragraphs.map((paragraph) => <p class="text-pretty">{paragraph}</p>)}
		</div>
	</div>
</AboutSection>

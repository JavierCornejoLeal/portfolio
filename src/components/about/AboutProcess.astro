---
import AboutSection from './AboutSection.astro';
import { process } from '@/data/about';
---

<AboutSection id="process" number={2} title="How I work">
	<!-- Hollow numbers that fill as the pointer reaches their step. -->
	<ol class="border-t border-ink/15">
		{
			process.map((step, i) => (
				<li
					data-reveal
					class="group grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-x-6 sm:items-center gap-y-2 border-b border-ink/15 py-8 sm:grid-cols-[7rem_minmax(0,14rem)_minmax(0,1fr)] sm:gap-x-10"
				>
					<span
						aria-hidden="true"
						class="process-number font-poster text-[clamp(3rem,5vw,4.5rem)] leading-none transition-colors duration-500 group-hover:text-ink motion-reduce:transition-none"
					>
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3 class="font-display text-xl font-semibold tracking-[-0.01em]">
						<span class="sr-only">{String(i + 1).padStart(2, '0')} </span>
						{step.title}
					</h3>
					<p class="col-start-2 leading-relaxed text-pretty text-ink/70 sm:col-start-3">{step.text}</p>
				</li>
			))
		}
	</ol>
</AboutSection>

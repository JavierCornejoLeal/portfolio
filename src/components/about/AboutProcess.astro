---
import AboutSection from './AboutSection.astro';
import { process } from '@/data/about';
import { TextHoverEffect } from '@/components/ui/text-hover-effect';
---

<AboutSection id="process" title="How I work">
	<!-- Hollow numbers, drawn in as they arrive, that light up green under the pointer (the numbers only). -->
	<ol>
		{
			process.map((step, i) => (
				<li class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-x-6 gap-y-2 py-8 sm:grid-cols-[7rem_minmax(0,14rem)_minmax(0,1fr)] sm:gap-x-10">
					<div data-step-number aria-hidden="true" class="aspect-[112/90] w-full">
						<TextHoverEffect client:visible text={String(i + 1).padStart(2, '0')} viewBox="0 0 112 90" fontSize={72} strokeWidth={1.2} spotlight="45%" />
					</div>
					<h3 class="font-display text-xl font-semibold tracking-[-0.01em]">
						<span class="sr-only">{String(i + 1).padStart(2, '0')} </span>
						{step.title}
					</h3>
					<p class="col-start-2 leading-relaxed text-pretty text-ink/70 sm:col-start-3">{step.text}</p>
				</li>
			))
		}
	</ol>
</AboutSection>

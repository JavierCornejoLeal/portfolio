---
import AboutSection from './AboutSection.astro';
import { stack } from '@/data/portfolio';
---

<AboutSection id="stack" number={4} title="Stack">
	<div class="flex flex-col gap-12">
		<div class="grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4">
			{
				stack.map((group) => (
					<div data-reveal class="flex flex-col gap-5">
						<h3 class="legend border-b border-ink/15 pb-3 text-ink/50">{group.group}</h3>
						<ul class="flex flex-col gap-1.5">
							{group.items.map((item) => (
								<li class="text-[clamp(1.25rem,1.9vw,1.75rem)] leading-tight font-light tracking-[-0.01em]">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p data-reveal class="text-ink/50">What I reach for most. The right tool for the job beats a favourite one.</p>
	</div>
</AboutSection>

---
import AboutSection from './AboutSection.astro';
import { cvFor } from '@/data/portfolio';
import type { Locale } from '@/lib/i18n';
import { uiFor } from '@/data/ui';

const { locale } = Astro.props as { locale: Locale };
const { stack } = cvFor(locale);
const ui = uiFor(locale).about;
---

<AboutSection id="stack" title={ui.sections.stack}>
	<div class="flex flex-col gap-12">
		<div class="grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-3">
			{
				stack.map((group) => (
					<div class="flex flex-col gap-5">
						<h3 class="legend text-ink/50">{group.group}</h3>
						<ul class="flex flex-col gap-1.5">
							{group.items.map((item) => (
								<li class="text-[clamp(1.25rem,1.9vw,1.75rem)] leading-tight font-light tracking-[-0.01em]">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="text-ink/50">{ui.stackNote}</p>
	</div>
</AboutSection>

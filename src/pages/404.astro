---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page not found">
	<main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6">
		<h1 class="text-4xl font-bold tracking-tight sm:text-6xl">404</h1>
		<p class="mt-4 text-lg text-zinc-400">This page does not exist.</p>
		<a href="/" class="mt-8 text-zinc-100 underline underline-offset-4 hover:text-zinc-300">Back home</a>
	</main>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { GlassCta } from '@/components/ui/glass-cta';
---

<!--
	Not found: one solid black, a big 404 pressed into it like the name in the footer, and a liquid-glass way back home.
	It opens with the black curtain drawing back, and Back home leaves behind the same curtain (lib/curtain.ts).
-->
<Layout title="Page not found · Javier Cornejo" noindex siteLoader={false} revealOnLoad>
	<main class="flex min-h-dvh w-full flex-col items-center justify-center gap-8 bg-black px-6 text-center">
		<h1>
			<span class="sr-only">404</span>
			<span data-not-found-number aria-hidden="true" class="not-found-number">404</span>
		</h1>
		<p class="text-lg text-ink/60">This page does not exist.</p>
		<GlassCta client:load href="/">Back home</GlassCta>
	</main>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { projects, type Project } from '@/data/projects';
import SiteMenu from '@/components/SiteMenu';

/*
 * A project's page. For now its opening screen only: black, the site's glass menu top right, and the project's
 * name set big at the foot, its letters rising one after another out of their own masks
 * (.letter-mask / .letter in global.css). The rest of the page fills in project by project.
 */

export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
// Letters are numbered across the whole name, so the rise runs left to right through every word.
let index = 0;
const words = project.name.split(' ').map((word) => [...word].map((letter) => ({ letter, index: index++ })));
---

<Layout title={`${project.name} · Javier Cornejo`} noindex siteLoader={false}>
	<main class="min-h-dvh bg-black text-ink">
		<!-- The site's glass menu, pinned top right as on the home page; its section links lead back home. -->
		<div class="fixed top-6 right-6 z-40 sm:top-8 sm:right-10">
			<SiteMenu client:load home="/" />
		</div>
		<section class="flex min-h-dvh flex-col justify-end px-[clamp(1.5rem,7vw,10rem)] pb-10">

			<div>
				<h1 class="font-poster text-[clamp(4.5rem,9vw,10rem)] leading-none text-balance uppercase">
					<span class="sr-only">{project.name}</span>
					<span aria-hidden="true">
						{
							words.map((word, w) => (
								<>
									{w > 0 && ' '}
									<span class="inline-block whitespace-nowrap">
										{word.map(({ letter, index }) => (
											<span data-letter-mask class="letter-mask">
												<span data-letter class="letter" style={`--i: ${index}`}>
													{letter}
												</span>
											</span>
										))}
									</span>
								</>
							))
						}
					</span>
				</h1>
				<hr data-project-rule class="mt-8 border-0 border-t border-ink/20" />
			</div>
		</section>
	</main>
</Layout>

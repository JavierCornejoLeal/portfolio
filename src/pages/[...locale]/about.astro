---
import Layout from '@/layouts/Layout.astro';
import SiteControls from '@/components/SiteControls.astro';
import DepthImage from '@/components/DepthImage';
import AboutWho from '@/components/about/AboutWho.astro';
import AboutLife from '@/components/about/AboutLife.astro';
import AboutProcess from '@/components/about/AboutProcess.astro';
import AboutExperience from '@/components/about/AboutExperience.astro';
import AboutStack from '@/components/about/AboutStack.astro';
import AboutFaq from '@/components/about/AboutFaq.astro';
import AboutRail from '@/components/about/AboutRail';
import PageFooter from '@/components/PageFooter';
import { localeParams, localePath, toLocale } from '@/lib/i18n';
import { uiFor } from '@/data/ui';

export function getStaticPaths() {
	return localeParams().map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const home = localePath(locale, '/');
const ui = uiFor(locale).about;
// The sections in page order, for the rail's title.
const sections = (['who', 'life', 'process', 'experience', 'stack', 'faq'] as const).map((id) => ({ id, title: ui.sections[id] }));


---

<!-- About: it opens on a statue in the dark, relit by a light that follows the cursor (DepthImage), with the page's
     name and a Roman boast top right catching the same light; then six sections about Javier. Kept out of search
     until the page is finished. -->
<Layout title={ui.title} locale={locale} noindex siteLoader={false}>
	<!-- The language switch and the site's glass menu, pinned top right as everywhere; its section links lead back home. -->
	<SiteControls locale={locale} home={home} />
	<main class="min-h-dvh bg-black">
		<section id="top" class="relative h-dvh">
			<DepthImage
				client:load
				image="/about/statue.webp"
				alt={ui.statueAlt}
				backgroundColor="#000000"
				className="size-full"
			>
				<!-- Top right, under the menu and set in to the content's edge: the page's name, lit by the statue's light. -->
				<div class="pointer-events-none flex size-full flex-col items-end px-[clamp(1.5rem,7vw,10rem)] pt-[clamp(7rem,16dvh,10rem)] text-right">
					<h1 data-light-catch class="light-catch font-poster text-[clamp(4rem,10vw,9rem)] leading-none uppercase">{ui.heading}</h1>
				</div>
			</DepthImage>
			<!-- The statue sinks into the black below it, so the page carries on without a seam. -->
			<div
				data-statue-fade
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-[38%] bg-[linear-gradient(to_bottom,rgba(0,0,0,0),#000)]"
			></div>
		</section>
		<!-- Then who he is, who he is off the clock, how he works, where, with what, and the questions people ask. On wide
		     screens one title stays put on the left and rolls to each section as it arrives. -->
		<div
			data-about-body
			class="px-[clamp(1.5rem,7vw,10rem)] pb-[clamp(4rem,12vh,8rem)] md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,2.6fr)] md:gap-20"
		>
			<div class="hidden md:block">
				<div class="sticky top-[clamp(7rem,20vh,10rem)] py-[clamp(4rem,12vh,8rem)]">
					<AboutRail client:load sections={sections} />
				</div>
			</div>
			<div class="min-w-0">
				<AboutWho locale={locale} />
				<AboutLife locale={locale} />
				<AboutProcess locale={locale} />
				<AboutExperience locale={locale} />
				<AboutStack locale={locale} />
				<AboutFaq locale={locale} />
			</div>
		</div>
	</main>
	<!-- The year comes from the visitor's clock, so the footer renders in the browser. -->
	<PageFooter client:only="react" home={home} locale={locale} />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import FlutedGlass from '@/components/FlutedGlass';
import { DockMenu, GlassCta, LatestWork } from '@/components/HeroGlass';
import { projects } from '@/data/portfolio';

// Projects are listed newest first.
const latest = projects[0];
---

<Layout>
	<main class="relative min-h-dvh overflow-x-clip">
		<div class="absolute inset-0">
			<FlutedGlass
				client:only="react"
				className="size-full"
				colors={['#2ee600', '#abff90']}
				backgroundColor="#070907"
				autoplay="touch"
			/>
		</div>
		<div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<!-- Geometry (insets and the name's size) lives in .hero in global.css, so it can follow the screen's height. -->
		<section class="hero pointer-events-none relative z-10 flex min-h-dvh flex-col gap-8">
			<!-- Elements arrive top to bottom: see .place-in in global.css. Only the menu sits close to its corner. -->
			<div class="place-in pointer-events-auto absolute top-6 right-6 z-20 sm:top-8 sm:right-10" style="--place-delay: 0.1s">
				<DockMenu client:load />
			</div>
			<header class="pr-16 sm:pr-20">
				<div class="place-in max-w-md" style="--place-delay: 0.2s">
					<p
						class="font-display text-lg leading-[1.2] font-semibold tracking-[-0.01em] text-balance uppercase sm:text-2xl"
					>
						Code you can see through: clear, honest software, from the database to the last pixel.
					</p>
				</div>
			</header>

			<!-- The name runs edge to edge, past the content insets, when the screen is tall enough for it. -->
			<div class="hero-bleed flex flex-1 items-center justify-center">
				<h1
					class="place-in hero-name font-poster text-center leading-[0.9] uppercase max-sm:[word-spacing:100vw] sm:whitespace-nowrap"
					style="--place-delay: 0.45s"
				>
					<!-- Stretched on an inner span: the entrance animation owns the h1's transform. The stretch takes no
					     layout room; the size formula in .hero leaves space for it. -->
					<span class="name-fade inline-block origin-center scale-y-[1.3]">Javier Cornejo</span>
				</h1>
			</div>

			<div class="flex flex-col items-stretch gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div class="place-in pointer-events-auto w-full sm:max-w-sm" style="--place-delay: 0.8s">
					<LatestWork
						client:load
						title={latest.title}
						context={latest.context}
						summary={latest.summary}
						href={latest.links[0].href}
					/>
				</div>
				<div class="place-in pointer-events-auto shrink-0 self-end" style="--place-delay: 0.95s">
					<GlassCta client:load href="#contact">Let's talk</GlassCta>
				</div>
			</div>
		</section>
	</main>
</Layout>

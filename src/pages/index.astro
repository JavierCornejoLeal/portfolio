---
import Layout from '@/layouts/Layout.astro';
import Silk from '@/components/Silk';
import CurtainText from '@/components/CurtainText.astro';

const year = new Date().getFullYear();

const SOCIALS_START = 2;
const SOCIAL_STEP = 0.03;

// Chain the links so each one starts right after the previous link's last glyph
let socialCursor = SOCIALS_START;
const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/javiiicornejo/' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/cornejolealjavier/' },
	{ label: 'GitHub', href: 'https://github.com/JavierCornejoLeal' }
].map(social => {
	const delay = socialCursor;
	socialCursor += social.label.length * SOCIAL_STEP;
	return { ...social, delay };
});
const footerStart = socialCursor;
---

<Layout>
	<main class="relative min-h-dvh overflow-x-clip">
		<div class="absolute inset-0">
			<Silk
				client:only="react"
				color="#3F3A46"
				sheenColor="#C9C3D6"
				speed={4}
				scale={1}
				noiseIntensity={1.2}
			/>
		</div>
		<div class="silk-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<section
			class="pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-6xl flex-col gap-12 px-6 py-8 sm:px-10 sm:py-10"
		>
			<div class="flex flex-1 flex-col items-center justify-center text-center">
				<h1
					class="font-display text-[clamp(3rem,12.5vw,9rem)] leading-[0.95] font-extrabold tracking-[-0.03em] uppercase"
				>
					<CurtainText text="Incoming" delay={0.35} step={0.07} />
				</h1>
				<p class="mt-8 max-w-3xl text-xl text-balance text-zinc-200 sm:text-2xl md:text-3xl">
					<CurtainText
						text="Something big is on its way. I'm building my new portfolio right now, piece by piece."
						delay={1}
						step={0.012}
					/>
				</p>
			</div>

			<footer class="flex flex-col items-center gap-4 text-center">
				<ul class="flex flex-wrap justify-center gap-x-8 gap-y-2" aria-label="Social links">
					{
						socials.map(social => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									class="curtain-group pointer-events-auto text-sm text-zinc-200 underline decoration-zinc-500 decoration-1 underline-offset-[6px] transition-colors duration-300 hover:text-white hover:decoration-silk"
								>
									<CurtainText text={social.label} delay={social.delay} step={SOCIAL_STEP} />
									<span class="sr-only">(opens in a new tab)</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="text-xs text-zinc-300">
					<CurtainText
						text={`© ${year} Javier Cornejo. All rights reserved. Designed and built by Javier Cornejo.`}
						delay={footerStart}
						step={0.008}
					/>
				</p>
			</footer>
		</section>
	</main>
</Layout>

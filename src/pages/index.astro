---
import Layout from '@/layouts/Layout.astro';
import FlutedGlass from '@/components/FlutedGlass';
import { DockMenu, GlassCta } from '@/components/HeroGlass';
import CurtainText from '@/components/CurtainText.astro';
---

<Layout>
	<main class="relative min-h-dvh overflow-x-clip">
		<div class="absolute inset-0">
			<FlutedGlass
				client:only="react"
				className="size-full"
				colors={['#2ee600', '#abff90']}
				backgroundColor="#070907"
				autoplay="touch"
			/>
		</div>
		<div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<section
			class="pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-7xl flex-col gap-10 px-6 py-6 sm:px-10 sm:py-8"
		>
			<header class="flex items-start justify-between gap-6">
				<h1
					class="font-poster text-[clamp(2rem,calc((100vw-8rem)/6.2),10.5rem)] leading-[0.82] tracking-[-0.01em] uppercase [word-spacing:100vw]"
				>
					<CurtainText text="Javier Cornejo" delay={0.35} step={0.06} />
				</h1>
				<div class="pointer-events-auto shrink-0">
					<DockMenu client:load />
				</div>
			</header>

			<div class="mt-auto flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
				<p class="max-w-xl">
					<span class="legend block text-harlequin-300">
						<CurtainText text="Full stack developer" delay={1.1} step={0.02} />
					</span>
					<span class="mt-4 block font-display text-[clamp(1.75rem,4.5vw,3.25rem)] leading-[1.05] font-medium tracking-[-0.02em] text-balance">
						<CurtainText text="Code you can see through." delay={1.5} step={0.03} />
					</span>
				</p>
				<div class="pointer-events-auto shrink-0">
					<GlassCta client:load href="#contact">Let's talk</GlassCta>
				</div>
			</div>
		</section>
	</main>
</Layout>

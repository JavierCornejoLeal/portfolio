---
import Layout from '@/layouts/Layout.astro';
import FlutedGlass from '@/components/FlutedGlass';
import { DockMenu, MobileDock } from '@/components/HeroGlass';
import { GlassSplitLink } from '@/components/ui/glass-split-link';
import Statement from '@/components/Statement';
import LivingGradient from '@/components/LivingGradient';
import ProjectsCarousel from '@/components/ProjectsCarousel';
---

<Layout>
	<!-- One living backdrop behind the whole page, so sections flow into each other with no seam. It is
	     subtle behind the hero and grows to full brightness over the first screen of scroll. -->
	<div class="fixed inset-0 -z-10" aria-hidden="true">
		<LivingGradient client:only="react" className="size-full" scrollIntensity={[0.5, 1]} />
	</div>
	<main class="relative overflow-x-clip">
		<!-- The hero owns its backdrop: the fluted glass covers this first screen only. -->
		<div class="relative">
		<!-- The glass fades out towards the hero's foot, so its flutes melt into the living backdrop below. -->
		<div class="hero-glass-fade absolute inset-0" data-hero-bg>
			<FlutedGlass
				client:only="react"
				className="size-full"
				colors={['#2ee600', '#abff90']}
				backgroundColor="transparent"
				texture={0}
				autoplay="touch"
			/>
		</div>
		<div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<!-- Geometry (insets and the name's size) lives in .hero in global.css, so it can follow the screen's height. -->
		<section class="hero pointer-events-none relative z-10 flex min-h-dvh flex-col justify-end gap-8">
			<!-- Elements arrive top to bottom: see .place-in in global.css. Only the menu sits close to its corner. -->
			<div class="place-in pointer-events-auto absolute top-6 right-6 z-20 sm:top-8 sm:right-10" style="--place-delay: 0.1s">
				<DockMenu client:load />
			</div>
			<!-- The name runs edge to edge, past the content insets. From sm up it sits dead centre on the screen,
			     out of the flow; on phones it takes the room between the top and the foot. -->
			<div class="hero-bleed flex flex-1 items-center justify-center sm:absolute sm:inset-0">
				<h1
					class="place-in hero-name font-poster text-center leading-[0.9] uppercase max-sm:[word-spacing:100vw] sm:whitespace-nowrap"
					style="--place-delay: 0.45s"
				>
					<!-- Stretched on an inner span (wider and taller, like a cover): the entrance animation owns the h1's
					     transform. The stretch takes no layout room; the size formula in .hero leaves space for it. -->
					<span class="name-fade name-stretch inline-block origin-center">Javier Cornejo</span>
				</h1>
			</div>

			<!-- Foot of the cover: the slogan as one long line bottom left, the way into the work bottom right. -->
			<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-12">
				<div class="place-in max-w-3xl" style="--place-delay: 0.8s">
					<p
						class="font-display text-lg leading-[1.25] font-semibold tracking-[-0.01em] text-pretty uppercase sm:text-xl"
					>
						Code you can see through: clear, honest software, from the database to the last pixel.
					</p>
				</div>
				<div class="place-in pointer-events-auto shrink-0" style="--place-delay: 0.95s">
					<GlassSplitLink client:load href="#projects">Discover works</GlassSplitLink>
				</div>
			</div>
		</section>
		</div>

		<Statement client:load />

		<!-- Hydrates ahead of arrival so the covers are ready to rise in when the section scrolls into view. -->
		<ProjectsCarousel client:visible={{ rootMargin: '600px' }} />

		<!-- On phones the menu is a dock pinned to the bottom of the screen, always there. It runs its own entrance
		     inside the fixed nav: an animated ancestor would become its containing block and unpin it. -->
		<MobileDock client:load />
	</main>
</Layout>

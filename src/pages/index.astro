---
import Layout from '@/layouts/Layout.astro';
import FlutedGlass from '@/components/FlutedGlass';
import { DockMenu, GlassCta, LatestWork } from '@/components/HeroGlass';
import { projects } from '@/data/portfolio';

// Projects are listed newest first.
const latest = projects[0];
---

<Layout>
	<main class="relative min-h-dvh overflow-x-clip">
		<div class="absolute inset-0">
			<FlutedGlass
				client:only="react"
				className="size-full"
				colors={['#2ee600', '#abff90']}
				backgroundColor="#070907"
				autoplay="touch"
			/>
		</div>
		<div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
		<section
			class="pointer-events-none relative z-10 flex min-h-dvh flex-col gap-8 px-6 py-6 sm:px-10 sm:py-8"
		>
			<!-- Each element is placed by hand, one after another: see .place-in in global.css. -->
			<header class="flex items-start justify-between gap-6">
				<div class="place-in max-w-md pt-2" style="--place-delay: 0.15s; --place-tilt: -2.5deg">
					<p
						class="font-display text-lg leading-[1.2] font-semibold tracking-[-0.01em] text-balance uppercase sm:text-2xl"
					>
						Code you can see through: clear, honest software, from the database to the last pixel.
					</p>
				</div>
				<div class="place-in pointer-events-auto shrink-0" style="--place-delay: 1.05s; --place-tilt: 6deg">
					<DockMenu client:load />
				</div>
			</header>

			<div class="flex flex-1 items-center justify-center">
				<h1
					class="place-in font-poster text-center leading-[0.9] uppercase max-sm:[word-spacing:100vw] text-[min(calc((100vw-3rem)/3.4),26dvh)] sm:whitespace-nowrap sm:text-[min(calc((100vw-5rem)/6.15),34dvh)]"
					style="--place-delay: 0.4s; --place-tilt: -1.5deg"
				>
					Javier Cornejo
				</h1>
			</div>

			<div class="flex flex-col items-stretch gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div class="place-in pointer-events-auto w-full sm:max-w-sm" style="--place-delay: 0.7s; --place-tilt: 3deg">
					<LatestWork
						client:load
						title={latest.title}
						context={latest.context}
						summary={latest.summary}
						href={latest.links[0].href}
					/>
				</div>
				<!-- Held in from the corner so it reads as placed, not parked. -->
				<div class="place-in pointer-events-auto shrink-0 self-end sm:mr-8 sm:mb-8" style="--place-delay: 0.9s; --place-tilt: -4deg">
					<GlassCta client:load href="#contact">Let's talk</GlassCta>
				</div>
			</div>
		</section>
	</main>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Silk from '@/components/Silk';

const headline = 'Incoming';
const year = new Date().getFullYear();

const contacts = [
	{ label: 'Instagram', value: '@javiiicornejo', href: 'https://www.instagram.com/javiiicornejo/', external: true },
	{ label: 'LinkedIn', value: 'cornejolealjavier', href: 'https://www.linkedin.com/in/cornejolealjavier/', external: true },
	{ label: 'GitHub', value: 'JavierCornejoLeal', href: 'https://github.com/JavierCornejoLeal', external: true },
	{ label: 'Email', value: 'cornejolealjavier@gmail.com', href: 'mailto:cornejolealjavier@gmail.com', external: false },
	{ label: 'Phone', value: '+34 634 443 602', href: 'tel:+34634443602', external: false }
];
---

<Layout title="Javier Cornejo · Incoming">
	<main class="relative min-h-dvh overflow-x-clip">
		<div class="absolute inset-0">
			<Silk
				client:only="react"
				color="#3F3A46"
				sheenColor="#C9C3D6"
				speed={4}
				scale={1}
				noiseIntensity={1.2}
			/>
		</div>
		<div
			class="silk-scrim pointer-events-none absolute inset-0"
			aria-hidden="true"
		>
		</div>
		<section
			class="pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-6xl flex-col gap-12 px-6 py-8 sm:px-10 sm:py-10"
		>
			<header class="curtain-fade flex items-baseline justify-between gap-6 text-sm" style="--delay: 0.2s">
				<p class="font-display font-medium tracking-wide">Javier Cornejo</p>
				<p class="text-zinc-300">Full stack developer</p>
			</header>

			<div class="flex flex-1 flex-col justify-center">
				<h1
					class="font-display text-[clamp(2.75rem,12vw,6rem)] leading-[0.95] font-extrabold tracking-[-0.03em] uppercase"
					aria-label={headline}
				>
					{
						[...headline].map((letter, i) => (
							<span class="curtain-letter" style={`--i: ${i}`} aria-hidden="true">
								{letter}
							</span>
						))
					}
				</h1>
				<p class="curtain-fade mt-6 max-w-xl text-lg text-pretty text-zinc-200 sm:text-xl" style="--delay: 1.1s">
					Something big is on its way. I'm building my new portfolio right now, piece by piece.
				</p>

				<ul class="curtain-fade mt-10 flex flex-col gap-3 sm:mt-12" style="--delay: 1.4s" aria-label="Contact">
					{
						contacts.map(contact => (
							<li>
								<a
									href={contact.href}
									class="group pointer-events-auto inline-flex items-baseline gap-4 py-1"
									{...(contact.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
								>
									<span class="font-display w-28 shrink-0 text-xs font-medium tracking-[0.18em] text-zinc-400 uppercase transition-colors duration-300 group-hover:text-silk">
										{contact.label}
									</span>
									<span class="text-base text-zinc-100 underline decoration-zinc-500 decoration-1 underline-offset-[6px] transition-colors duration-300 group-hover:decoration-silk">
										{contact.value}
									</span>
									{contact.external && <span class="sr-only">(opens in a new tab)</span>}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<footer
				class="curtain-fade flex flex-col gap-1 text-xs text-zinc-300 sm:flex-row sm:justify-between"
				style="--delay: 1.7s"
			>
				<p>&copy; {year} Javier Cornejo. All rights reserved.</p>
				<p>Designed and built by Javier Cornejo.</p>
			</footer>
		</section>
	</main>
</Layout>

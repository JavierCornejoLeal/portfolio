---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Keep the page out of search results (e.g. the 404). */
	noindex?: boolean;
}

const SITE_NAME = 'Javier Cornejo';
const DEFAULT_DESCRIPTION =
	'Javier Cornejo, full stack developer. Something big is on its way: a new portfolio is being built right now.';

const { title = SITE_NAME, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_NAME,
	jobTitle: 'Full stack developer',
	url: Astro.site?.href,
	image: ogImage.href,
	sameAs: [
		'https://www.instagram.com/javiiicornejo/',
		'https://www.linkedin.com/in/cornejolealjavier/',
		'https://github.com/JavierCornejoLeal'
	]
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE_NAME} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#09090b" />
		<meta name="color-scheme" content="dark" />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Javier Cornejo, full stack developer" />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
	</head>
	<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
		<slot />
	</body>
</html>

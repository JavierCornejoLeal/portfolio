---
import '../styles/global.css';
import PageLoader from '@/components/PageLoader';

interface Props {
	title?: string;
	description?: string;
	/** Keep the page out of search results (e.g. the 404). */
	noindex?: boolean;
}

const SITE_NAME = 'Javier Cornejo';
const DEFAULT_DESCRIPTION =
	'Javier Cornejo, full stack developer. Code you can see through: clear, honest software from database to pixel.';

const { title = SITE_NAME, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_NAME,
	jobTitle: 'Full stack developer',
	url: Astro.site?.href,
	image: ogImage.href,
	sameAs: [
		'https://www.instagram.com/javiiicornejo/',
		'https://www.linkedin.com/in/cornejolealjavier/',
		'https://github.com/JavierCornejoLeal'
	]
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				var seen = false;
				try {
					seen = sessionStorage.getItem('loader-seen') === '1';
				} catch (e) {}
				if (seen) return;
				root.classList.add('is-loading');
				// Failsafe: never trap the page behind the loader if the island fails to boot.
				setTimeout(function () {
					root.classList.remove('is-loading');
				}, 10000);
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE_NAME} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#070907" />
		<meta name="color-scheme" content="dark" />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Javier Cornejo, full stack developer" />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
	</head>
	<body class="min-h-screen font-sans text-ink antialiased">
		<div class="page-loader">
			<div aria-hidden="true">
				<PageLoader client:only="react" />
			</div>
			<p class="sr-only" role="status">Loading</p>
		</div>
		<slot />
		<script>
			// In-page links (#projects, #contact-inside, #top…) glide to their section without writing the #fragment
			// into the address. The smooth scroll itself is the page's CSS (scroll-behavior), so reduced motion still
			// jumps. A link already handled (default prevented), a modified click or a missing target is left alone.
			document.addEventListener('click', (event) => {
				if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
				const id = link?.getAttribute('href')?.slice(1);
				const target = id ? document.getElementById(id) : null;
				if (!target) return;
				event.preventDefault();
				// A section can ask to be shown by its end (the footer, so its last line is always in view).
				target.scrollIntoView({ block: target.dataset.scrollAlign === 'end' ? 'end' : 'start' });
			});
		</script>
	</body>
</html>
